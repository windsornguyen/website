{
  "name": "windsornguyen.com",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "tsx scripts/generate-llms.ts && react-router build",
    "llms": "tsx scripts/generate-llms.ts",
    "preview": "node scripts/start.mjs",
    "start": "node scripts/start.mjs",
    "deploy": "pnpm build && wrangler deploy",
    "site": "tsx scripts/site.ts",
    "ship": "bash scripts/ship.sh",
    "db": "tsx scripts/db.ts",
    "test": "pnpm llms && vp test --run",
    "test:smoke": "node --test tests/site-smoke.smoke.mjs",
    "lint": "vp lint . && markdownlint-cli2 \"**/*.{md,mdx}\" \"#node_modules\" \"#build\" \"#dist\" \"#.wrangler\" \"#CHANGELOG.md\"",
    "format": "vp fmt --write .",
    "check-format": "vp fmt --check .",
    "typecheck": "react-router typegen && tsgo --noEmit",
    "infra:fmt": "terraform -chdir=infra/cloudflare fmt -recursive",
    "infra:check": "terraform -chdir=infra/cloudflare fmt -check -recursive && TF_DATA_DIR=.terraform/infra-check terraform -chdir=infra/cloudflare init -backend=false -input=false && TF_DATA_DIR=.terraform/infra-check terraform -chdir=infra/cloudflare validate",
    "workflows": "hollywood generate --source-root ci --workflows-dir .github/workflows \"ci/*.ts\"",
    "check:workflows": "hollywood check --generated --workflow-security --source-root ci --workflows-dir .github/workflows",
    "check:cloudflare": "wrangler deploy --dry-run --strict --outdir .wrangler/tmp",
    "check": "vp lint . && markdownlint-cli2 \"**/*.{md,mdx}\" \"#node_modules\" \"#build\" \"#dist\" \"#.wrangler\" \"#CHANGELOG.md\" && pnpm check-format && pnpm typecheck && pnpm check:workflows",
    "check:vp": "vp check ."
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@react-router/node": "7.18.3",
    "@supabase/supabase-js": "^2.112.4",
    "@tailwindcss/vite": "^4.3.3",
    "cmdk": "^1.1.1",
    "codehike": "^1.1.0",
    "isbot": "^5.2.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "7.18.3",
    "sugar-high": "^0.9.5",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@dedalus-labs/hollywood": "0.0.1",
    "@mdx-js/rollup": "^3.1.1",
    "@react-router/dev": "7.18.3",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript/native-preview": "7.0.0-dev.20260320.1",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "cac": "^7.0.0",
    "markdownlint-cli2": "^0.23.2",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.81.0",
    "picocolors": "^1.1.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vite-plus": "^0.1.24",
    "vitest": "^4.1.11",
    "wrangler": "^4.128.0"
  },
  "packageManager": "pnpm@10.32.1"
}
