{
  "name": "windsornguyen.com",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "tsx scripts/generate-llms.ts && react-router build",
    "llms": "tsx scripts/generate-llms.ts",
    "preview": "node scripts/start.mjs",
    "start": "node scripts/start.mjs",
    "site": "tsx scripts/site.ts",
    "ship": "bash scripts/ship.sh",
    "db": "tsx scripts/db.ts",
    "test": "vp test --run",
    "test:smoke": "node --test tests/site-smoke.smoke.mjs",
    "lint": "vp lint . && markdownlint-cli2 \"**/*.{md,mdx}\" \"#node_modules\" \"#build\" \"#dist\" \"#CHANGELOG.md\"",
    "format": "vp fmt --write .",
    "check-format": "vp fmt --check .",
    "typecheck": "react-router typegen && tsgo --noEmit",
    "check": "vp lint . && markdownlint-cli2 \"**/*.{md,mdx}\" \"#node_modules\" \"#build\" \"#dist\" \"#CHANGELOG.md\" && pnpm check-format && pnpm typecheck",
    "check:vp": "vp check ."
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@react-router/node": "7.17.0",
    "@react-router/serve": "7.17.0",
    "@supabase/supabase-js": "^2.108.1",
    "@tailwindcss/vite": "^4.3.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/react-router": "^1.3.1",
    "@vercel/speed-insights": "^2.0.0",
    "cmdk": "^1.1.1",
    "codehike": "^1.1.0",
    "isbot": "^5.1.42",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "7.17.0",
    "sugar-high": "^0.9.5",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@react-router/dev": "7.17.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260320.1",
    "@vitejs/plugin-react": "^6.0.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "cac": "^7.0.0",
    "markdownlint-cli2": "^0.21.0",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0",
    "picocolors": "^1.1.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vite-plus": "^0.1.24",
    "vitest": "^4.1.8"
